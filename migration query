-- Step 5: Create a new table with only the columns you want to keep
CREATE TABLE feedback_table_new (
    CONSENT VARCHAR(255),
    FEEDBACK_EXP VARCHAR(255),
    FEEDBACK_ID BIGINT,
    FEEDBACK_SENT_ON DATE,
    FIRM_NAME VARCHAR(255),
    REPORT_ID BIGINT,
    USERNAME VARCHAR(255),
    feedback_data MEDIUMTEXT
);

-- Step 6: Copy data from the original table to the new table
INSERT INTO feedback_table_new (
    CONSENT,
    FEEDBACK_EXP,
    FEEDBACK_ID,
    FEEDBACK_SENT_ON,
    FIRM_NAME,
    REPORT_ID,
    USERNAME,
    feedback_data
)
SELECT 
    CONSENT,
    FEEDBACK_EXP,
    FEEDBACK_ID,
    FEEDBACK_SENT_ON,
    FIRM_NAME,
    REPORT_ID,
    USERNAME,
    feedback_data
FROM feedback_table;

